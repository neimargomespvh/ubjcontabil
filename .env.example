# Banco destino (PostgreSQL)
ERP_DATABASE_URL=postgresql://erp:erp_secret@localhost:5432/erp_contabil

# Auth do painel Admin (JWT)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=480
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# Diretórios
MIGRACAO_UPLOAD_DIR=uploads
MIGRACAO_LOG=migracao_erros.log

# Sync Delta (opcional)
DELTA_BASE_URL=
DELTA_API_KEY=

# Worker
SYNC_BATCH_SIZE=100
SYNC_POLL_INTERVAL_S=5
